MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=unilib

# Optional: override the full SQLAlchemy connection string.
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/unilib?charset=utf8mb4

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=45

# MoMo payment integration.
# Use sandbox while testing, then replace with production endpoint and credentials from MoMo.
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REQUEST_TYPE=captureWallet

# Public URL for MoMo redirectUrl/ipnUrl. For local testing with real MoMo callbacks,
# expose port 3000 with a public HTTPS tunnel and put that URL here.
# PUBLIC_BASE_URL=https://your-public-domain.example

# Average borrow fee for 30 days. Fee scales linearly by borrow_days / 30.
BORROW_BASE_PRICE_30_DAYS=28000

# Enable this while you do not have real MoMo API credentials.
# The payment endpoint will mark the borrow payment as paid immediately.
PAYMENT_TEST_MODE=false
